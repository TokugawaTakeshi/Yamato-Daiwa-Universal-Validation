extends ../../../Layouts/AccessControl/AccessControlLayout.pug


block append Requirements

  include ../../../SharedAssets/Markup/SharedAssets.pug
  include ../../../SharedGUI_Components/SharedGUI_Components.pug


block append Metadata

  -

    /** @type { PasswordRecoveryPageStringResources }  */
    const $pageStringResources = IMPORTS_FROM_TYPESCRIPT.stringResources.pages.accessControl.passwordResetting[$$LOCALE];

    RegularWebPageTemplate__YDF.configure({
      metadata: {
        title: $pageStringResources.pageTitle
      },
      stylesSheetsURIs: [
        "@Shared/Primer",
        "@ExternalSharedGUI_Components",
        "@InternalSharedGUI_Components",
        "@LayoutsForStaticPreview/AccessControl/AccessControlLayout",
        "@ApplicationPagesForStaticPreview/AccessControl/PasswordRecovery/PasswordRecoveryPage"
      ]
    });


block append SpecificContent

  h1.AccessControlLayout-TopHeading= $pageStringResources.topHeading

  if $$passwordRecoveryPagePageStatesSimulations.isEmailInputtingStep

    +AdmonitionBlock--YDF({
      SVG_Icon: true,
      decorativeVariation: AdmonitionBlock__YDF.DecorativeVariations.guidance
    }).AccessControlLayout-AdmonitionBlock= $pageStringResources.steps.emailInputting.guidance

    +TextBox--YDF({
      label: $pageStringResources.steps.emailInputting.textBoxes.emailAddress.label,
      HTML_Type: TextBox__YDF.HTML_Types.email,
      autocomplete: "email"
    }).AccessControlLayout-TextBox

    +Button--YDF({
      label: $pageStringResources.steps.emailInputting.submittingButton.label,
      HTML_Type: Button__YDF.HTML_Types.submit
    }).AccessControlLayout-SubmittingButton


  else if $$passwordRecoveryPagePageStatesSimulations.isRecoveryCodeInputtingStep

    +AdmonitionBlock--YDF({
      SVG_Icon: true,
      decorativeVariation: AdmonitionBlock__YDF.DecorativeVariations.guidance
    }).AccessControlLayout-AdmonitionBlock
      | #{ $pageStringResources.steps.recoveryCodeInputting.guidances.emailSubmitting }

    +AdmonitionBlock--YDF({
      title: $pageStringResources.steps.recoveryCodeInputting.guidances.spamFalsePositive.title,
      SVG_Icon: true,
      decorativeVariation: AdmonitionBlock__YDF.DecorativeVariations.warning
    }).AccessControlLayout-AdmonitionBlock
      | #{ $pageStringResources.steps.recoveryCodeInputting.guidances.spamFalsePositive.description }

    +TextBox--YDF({
      label: $pageStringResources.steps.recoveryCodeInputting.textBoxes.oneTimeCode,
      HTML_Type: TextBox__YDF.HTML_Types.password,
      autocomplete: "one-time-code"
    }).AccessControlLayout-TextBox

    +Button--YDF({
      label: $pageStringResources.steps.recoveryCodeInputting.submittingButton.label,
      HTML_Type: Button__YDF.HTML_Types.submit
    }).AccessControlLayout-SubmittingButton


  else

    +TextBox--YDF({
      label: $pageStringResources.inputs.password.label,
      HTML_Type: TextBox__YDF.HTML_Types.password,
      autocomplete: "new-password"
    }).AccessControlLayout-TextBox

    .AccessControlLayout-BottomActionBar

      +Button--YDF({
        label: $pageStringResources.buttons.signingIn.label,
        HTML_Type: Button__YDF.HTML_Types.submit
      })
